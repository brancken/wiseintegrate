# Copy this file to .env.local (on this computer) and paste the real values yourself.
# On the live host, the same names go in its environment settings. Never put real keys in this file or in GitHub.

# Stripe secret key: sk_test_... on this computer for testing, sk_live_... on the live site.
# Stripe dashboard > Developers > API keys > Secret key (in the sandbox for testing).
STRIPE_SECRET_KEY=

# Filled in automatically by scripts/stripe-setup.mjs (the 20% thank-you coupon ID; not secret).
STRIPE_THANKYOU_COUPON=

# Supabase secret key (service role). Supabase dashboard > Project Settings > API keys > secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Consultant dashboard password (choose a NEW one; the old one was visible on GitHub).
ADMIN_PASSWORD=
